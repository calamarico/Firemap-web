# Cabeceras servidas por Cloudflare Pages (equivalen a las que pone Express
# en el despliegue Node).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400

# La imagen OG va versionada en el nombre (og-image-vN): los scrapers de
# Facebook/Twitter cachean por URL y no hay otra forma fiable de invalidarlos.
/og-image-v2.jpg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
